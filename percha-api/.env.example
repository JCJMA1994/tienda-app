PORT=3000
NODE_ENV=development

# Migraciones (dueño de las tablas)
DATABASE_OWNER_URL=postgres://percha_owner:owner_dev_pass@localhost:5432/percha
# Operaciones de negocio (RLS aplicado)
DATABASE_APP_URL=postgres://percha_app:app_dev_pass@localhost:5432/percha
# Autenticación y registro (omite RLS; uso acotado)
DATABASE_SYSTEM_URL=postgres://percha_system:system_dev_pass@localhost:5432/percha

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
INVITATION_TTL_HOURS=72
CORS_ORIGINS=https://app.system-failed-tech.com

# Facturación SaaS
TRIAL_DAYS=14
TRIAL_PLAN=crece
BILLING_GRACE_DAYS=7
APP_URL=https://app.system-failed-tech.com
# Culqi (tarjetas, Yape y billeteras por QR). Llaves en CulqiPanel > Desarrollo.
CULQI_PUBLIC_KEY=
CULQI_SECRET_KEY=
# Stripe (tarjetas internacionales). Requiere una cuenta en un país soportado.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_API_URL=https://api.system-failed-tech.com

# Facturación electrónica (OSE/PSE). Genera la clave con:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EINVOICE_ENC_KEY=
EINVOICE_DISPATCH=async
-e 
# Consulta RUC/DNI (decolecta.com)
DECOLECTA_TOKEN=
-e # Respaldo autoalojado (opcional)
PERU_CONSULT_URL=
PERU_CONSULT_TOKEN=
-e 
# Push (Firebase Cloud Messaging), opcional
FCM_SERVICE_ACCOUNT_B64=

# Apachiy (consultas DNI/RUC/CPE de la plataforma). WhatsApp se configura por tienda en la app.
APACHIY_TOKEN=
# Clave para cifrar secretos de 2FA y tokens de WhatsApp (32 bytes base64)
SECRETS_ENC_KEY=
# Correo para recuperar contraseña (resend.com)
RESEND_API_KEY=
EMAIL_FROM=Percha <no-responder@system-failed-tech.com>

# Fotos de producto. En producción: Cloudflare R2 (o S3) con bucket público de solo lectura.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_ENDPOINT=https://<cuenta>.r2.cloudflarestorage.com
S3_BUCKET=percha-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_URL=https://media.system-failed-tech.com

# Panel web: sesión en cookie HttpOnly (strict si app y API comparten dominio).
WEB_COOKIE_SAMESITE=strict
# WEB_COOKIE_DOMAIN=.system-failed-tech.com
