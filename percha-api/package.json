{
  "name": "percha-api",
  "version": "0.1.0",
  "description": "API de Percha: inventario y POS multi-tenant para boutiques",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "jest --config jest.config.js --runInBand",
    "typecheck": "tsc --noEmit",
    "billing:run": "node scripts/billing-run.mjs",
    "admin:make": "node scripts/make-admin.mjs",
    "einvoice:run": "node scripts/einvoice-run.mjs",
    "padron:import": "node scripts/import-padron.mjs",
    "push:run": "node scripts/push-run.mjs",
    "layaways:run": "node scripts/layaways-run.mjs",
    "maintenance:run": "node scripts/maintenance-run.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/throttler": "^6.7.1",
    "@node-rs/argon2": "^2.2.2",
    "drizzle-orm": "^0.45.4",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pg-copy-streams": "^6.0.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.33.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "jest": "^29.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "~5.6"
  },
  "private": true
}
