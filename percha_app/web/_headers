# Cabeceras de seguridad del panel web (Netlify / Cloudflare Pages).
# Compila con:  flutter build web --release --no-web-resources-cdn --dart-define=API_BASE_URL=https://api.system-failed-tech.com/v1
# --no-web-resources-cdn sirve CanvasKit desde tu dominio: así la CSP no necesita gstatic.com.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' https://api.system-failed-tech.com https://fonts.gstatic.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https:; worker-src 'self' blob:; manifest-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'

# La app cambia en cada versión: index.html y el arranque nunca se cachean…
/index.html
  Cache-Control: no-cache
/flutter_bootstrap.js
  Cache-Control: no-cache
/flutter_service_worker.js
  Cache-Control: no-cache
# …el resto lleva huella en el nombre o cambia poco.
/assets/*
  Cache-Control: public, max-age=604800
/canvaskit/*
  Cache-Control: public, max-age=2592000, immutable
